{
  "name": "winter-letters-for-dasha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:iphone": "playwright test",
    "check:content": "node --import tsx scripts/check-content.ts",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "preview:phone": "npm run build && node scripts/preview-phone.mjs",
    "test:iphone:build": "npm run build && playwright test --config playwright.build.config.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/lora": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
